# Key used by the leaderboard to call this adapter. Generate a separate random value.
MEMORY_SYSTEM_KEY=replace_with_a_long_random_value

# Official Supermemory cloud API key. Do not commit this value.
SUPERMEMORY_API_KEY=sm_replace_me

# Optional server configuration.
PORT=6768
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
